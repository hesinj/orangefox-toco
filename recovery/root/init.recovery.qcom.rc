# Recovery init for Xiaomi Mi Note 10 Lite (toco) - SM6150
import /init.recovery.qcom_decrypt.rc

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    # libkeymasterdeviceutils loads the Keymaster trusted app from this hard-coded directory when the
    # secure world does not have it yet. On a booted system it is the 'modem' partition (vfat).
    # Read-only; if the mount fails nothing else depends on it.
    wait /dev/block/bootdevice/by-name/modem 5
    mkdir /vendor/firmware_mnt 0771 system system
    mount vfat /dev/block/bootdevice/by-name/modem /vendor/firmware_mnt ro nosuid nodev noexec shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337

on init
    setprop sys.usb.controller a600000.dwc3
    setprop sys.usb.configfs 1

    # The kernel boots with the 'performance' governor (CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE), which would keep all
    # eight cores at their top frequency for as long as the recovery runs. The installed system switches to schedutil
    # during boot; do the same (cpu0 = the six little cores, cpu6 = the two big ones). If a path is missing, init only
    # logs it.
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu6/cpufreq/scaling_governor schedutil

on boot
    start health-hal-2-1
    start fox_blackbox
    setprop sys.usb.config adb

# Black-box recorder: state of the recovery (memory, CPU frequencies, temperatures, blocked tasks with their kernel
# stacks, new kernel log lines) every few seconds to /cache/toco-bb/boot-N.log, flushed, so that a boot that hangs or
# panics leaves a record. Fetched with: adb pull /cache/toco-bb
service fox_blackbox /system/bin/fox_blackbox.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

# Writes the state of the decryption service chain (qseecomd, Keymaster HAL, keystore2) into
# /tmp/recovery.log while it starts, and once more if the recovery gives up waiting for it.
service fox_diag_run /system/bin/fox_decrypt_diag.sh run
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service fox_diag_final /system/bin/fox_decrypt_diag.sh final
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:crypto.ready=1
    start fox_diag_run

on property:fox.decrypt.state=timeout
    start fox_diag_final
