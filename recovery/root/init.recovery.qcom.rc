# Recovery init for Xiaomi Mi Note 10 Lite (toco) - SM6150
import /init.recovery.qcom_decrypt.rc

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    # libkeymasterdeviceutils loads the Keymaster trusted app from this hard-coded directory when the
    # secure world does not have it yet. On a booted system it is the 'modem' partition (vfat).
    # Read-only; if the mount fails nothing else depends on it.
    wait /dev/block/bootdevice/by-name/modem 5
    mkdir /vendor/firmware_mnt 0771 system system
    mount vfat /dev/block/bootdevice/by-name/modem /vendor/firmware_mnt ro nosuid nodev noexec shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337

on init
    setprop sys.usb.controller a600000.dwc3
    setprop sys.usb.configfs 1

on boot
    start health-hal-2-1
    setprop sys.usb.config adb

# Writes the state of the decryption service chain (qseecomd, Keymaster HAL, keystore2) into
# /tmp/recovery.log while it starts, and once more if the recovery gives up waiting for it.
service fox_diag_run /system/bin/fox_decrypt_diag.sh run
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

service fox_diag_final /system/bin/fox_decrypt_diag.sh final
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on property:crypto.ready=1
    start fox_diag_run

on property:fox.decrypt.state=timeout
    start fox_diag_final
