# mount point  fstype  device                                           device2   flags
# Generated from the orangefox-fbe-recovery-port template (config: port/device.conf).
# The flags= part of /data is what the TWRP/OrangeFox crypto code reads (fileencryption=, metadata_encryption=, keydirectory=).
#@@if has('boot')
/boot          emmc    /dev/block/bootdevice/by-name/boot
#@@endif
#@@if has('recovery')
/recovery      emmc    /dev/block/bootdevice/by-name/recovery           flags=backup=1
#@@endif
#@@if has('cache')
/cache         ext4    /dev/block/bootdevice/by-name/cache
#@@endif
#@@if has('metadata')
/metadata      ext4    /dev/block/bootdevice/by-name/metadata           flags=display="Metadata";backup=1
#@@endif
/data          @@USERDATA_FS@@    /dev/block/bootdevice/by-name/userdata           flags=@@DATA_TWRP_FLAGS@@
/storage       @@USERDATA_FS@@    /data/media/0                                    flags=display="Internal Storage";usermrf;backup=1;fsflags="bind";removable
#@@if has('dtbo')
/dtbo          emmc    /dev/block/bootdevice/by-name/dtbo               flags=backup=1;display="DTBO";flashimg=1
#@@endif
#@@if yes(MOUNT_FIRMWARE)
/firmware      vfat    /dev/block/bootdevice/by-name/@@FIRMWARE_PARTITION@@              flags=display="Firmware";mounttodecrypt;fsflags="ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337"
/firmware_image emmc   /dev/block/bootdevice/by-name/@@FIRMWARE_PARTITION@@              flags=display="Firmware";backup=1
#@@endif
#@@if has('misc')
/misc          emmc    /dev/block/bootdevice/by-name/misc
#@@endif
#@@if has('modem')
/modem         emmc    /dev/block/bootdevice/by-name/modem              flags=backup=1;display="Modem"
#@@endif
#@@if has('bluetooth')
/bluetooth     emmc    /dev/block/bootdevice/by-name/bluetooth          flags=backup=1;subpartitionof=/modem
#@@endif
#@@if has('dsp')
/dsp           emmc    /dev/block/bootdevice/by-name/dsp                flags=backup=1;subpartitionof=/modem
#@@endif
#@@if has('modemst1')
/efs1          emmc    /dev/block/bootdevice/by-name/modemst1           flags=backup=1;display=EFS
#@@endif
#@@if has('modemst2')
/efs2          emmc    /dev/block/bootdevice/by-name/modemst2           flags=backup=1;subpartitionof=/efs1
#@@endif
#@@if has('fsc')
/efsc          emmc    /dev/block/bootdevice/by-name/fsc                flags=backup=1;subpartitionof=/efs1
#@@endif
#@@if has('fsg')
/efsg          emmc    /dev/block/bootdevice/by-name/fsg                flags=backup=1;subpartitionof=/efs1
#@@endif
#@@if has('persist')
/persist       ext4    /dev/block/bootdevice/by-name/persist            flags=display="Persist"
/persist_image emmc    /dev/block/bootdevice/by-name/persist            flags=display="Persist";backup=1;flashimg=1
#@@endif
#@@if USB_OTG_DEVICE
# Removable storage
/usb_otg       vfat    @@USB_OTG_DEVICE@@1                               @@USB_OTG_DEVICE@@  flags=fsflags=utf8;display="USB-Storage";storage;wipeingui;removable
#@@endif
