@@ -125,6 +125,15 @@ endif
 # Enable address sanitizer flags for kernel except some files or directories
 # we don't want to check (depends on variables KASAN_SANITIZE_obj.o, KASAN_SANITIZE)
 #
+# toco debug kernel: with KASAN_ONLY set, only the directories matching one of its patterns are instrumented.
+# A fully instrumented kernel is 87 MB (+ 20 MB bss) and would run into the hypervisor's reserved memory at
+# 0x85700000 when the bootloader decompresses it at 0x80080000.
+ifneq ($(KASAN_ONLY),)
+ifeq ($(filter $(KASAN_ONLY),$(obj)),)
+KASAN_SANITIZE := n
+endif
+endif
+
