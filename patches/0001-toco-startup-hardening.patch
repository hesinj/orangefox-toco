@@ -669,6 +674,69 @@ int TWPartitionManager::Write_Fstab(void) {
 	return true;
 }
 
+#if defined(TW_INCLUDE_CRYPTO) && defined(TW_INCLUDE_FBE_METADATA_DECRYPT) && defined(USE_FSCRYPT)
+// The metadata decrypt below asks keystore2, which waits without any time limit for the vendor Keymaster HAL
+// (started from qseecomd). If one link of that chain never comes up, the recovery process used to sit on the
+// splash screen forever, with nothing in the log. Run the call in a worker thread instead, log what the chain
+// is doing while waiting, and give up after a while, so that the GUI (and adb) still come up.
+struct Fox_Md_Decrypt {
+	std::mutex m;
+	std::condition_variable cv;
+	bool done = false;
+	bool ok = false;
+};
+
+static void Fox_Log_Decrypt_Services(int waited) {
+	static const char* props[] = {
+		"init.svc.servicemanager", "init.svc.hwservicemanager", "init.svc.keystore2",
+		"init.svc.prepdecrypt", "init.svc.qseecomd", "init.svc.keymaster-4-1-qti",
+		"init.svc.gatekeeper-1-0-qti", "hwservicemanager.ready", "crypto.ready",
+		"vendor.sys.listeners.registered", "keymaster_ver"
+	};
+	std::string line;
+	for (const char* p : props)
+		line += std::string(p) + "=" + android::base::GetProperty(p, "-") + " ";
+	LOGINFO("Decrypt: waiting for the decryption services (%ds): %s\n", waited, line.c_str());
+}
+
+static bool Fox_Metadata_Decrypt_Bounded(const std::string& blk_device, const std::string& mount_point,
+		const std::string& fs_type, const std::string& fstab) {
+	int timeout = atoi(android::base::GetProperty("fox.decrypt.timeout", "90").c_str());
+	if (timeout < 10)
+		timeout = 10;
+	auto st = std::make_shared<Fox_Md_Decrypt>();
+	std::thread([st, blk_device, mount_point, fs_type, fstab]() {
+		bool r = android::vold::fscrypt_mount_metadata_encrypted(blk_device, mount_point, false, false, fs_type, fstab);
+		std::lock_guard<std::mutex> l(st->m);
+		st->ok = r;
+		st->done = true;
+		st->cv.notify_all();
+	}).detach();
+
+	android::base::SetProperty("fox.decrypt.state", "running");
+	std::unique_lock<std::mutex> l(st->m);
+	int waited = 0;
+	while (!st->done && waited < timeout) {
+		st->cv.wait_for(l, std::chrono::seconds(5), [&] { return st->done; });
+		if (!st->done) {
+			waited += 5;
+			l.unlock();
+			Fox_Log_Decrypt_Services(waited);
+			l.lock();
+		}
+	}
+	if (!st->done) {
+		LOGERR("Decrypt: the metadata decrypt did not finish within %d seconds. Giving up on decrypting /data.\n", timeout);
+		LOGERR("Decrypt: the decryption services did not answer. See 'fox-diag' in this log; adb: logcat -d, dmesg.\n");
+		gui_msg(Msg(msg::kError, "fox_decrypt_timeout=Decryption services did not answer in time, /data was not decrypted. See /tmp/recovery.log"));
+		android::base::SetProperty("fox.decrypt.state", "timeout");
+		return false;
+	}
+	android::base::SetProperty("fox.decrypt.state", st->ok ? "done" : "failed");
+	return st->ok;
+}
+#endif
